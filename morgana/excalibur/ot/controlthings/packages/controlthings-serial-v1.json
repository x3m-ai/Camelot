  "scripts": [
    {
      "id": "controlthings:ctserial:send-hex",
      "name": "CONTROLTHINGS - SERIAL - Send Raw Hex",
      "description": "ControlThings ctserial: Send raw hex payload to serial device. Sends data to serial devices in authorized lab environments.",
      "tactic": "Impair Process Control",
      "tcode": "T0831",
      "executor": "bash",
      "executor_config": {
        "timeout_seconds": 30,
        "result_parser": "morgana-marker-v1"
      },
      "platform": "linux",
      "command": "# ControlThings Serial — Send raw hex payload to serial device\nRUNNER='{{asset:controlthings_serial_runner}}'\n\ncase \"#{ct_serial_device}\" in ''|*[!A-Za-z0-9./_:-]*) echo \"[ERROR] Invalid device\" >&2; exit 2;; esac\n\npython3 \"$RUNNER\" ctserial connect \"#{ct_serial_device}\" #{ct_serial_baud} #{ct_serial_parity}\npython3 \"$RUNNER\" ctserial send_hex \"#{ct_serial_payload}\"\npython3 \"$RUNNER\" ctserial close\n\necho \"MORGANA_RESULT_METADATA={\\\"provider\\\":\\\"controlthings\\\",\\\"component\\\":\\\"ctserial\\\",\\\"operation\\\":\\\"send-hex\\\",\\\"status\\\":\\\"completed\\\"}\"",
      "cleanup_command": null,
      "required_tags": [
        "ct_serial_device",
        "ct_serial_baud",
        "ct_serial_parity",
        "ct_serial_payload",
        "ct_serial_timeout"
      ],
      "required_assets": [
        "controlthings_serial_runner"
      ],
      "operational_risk": "modify",
      "source_metadata": {
        "provider": "controlthings",
        "component": "ctserial",
        "source_repository": "ControlThings-io/ctserial",
        "source_commit": "58abc185a71ffa2d7abd93b55c44db8c14baca1e",
        "source_version": "0.5.0",
        "license": "LGPL-3.0-or-later",
        "operation": "send-hex",
        "protocol": "serial",
        "mitre_domain": "ics-attack",
        "source_modified": false
      }
    },
    {
      "id": "controlthings:ctserial:send-utf8",
      "name": "CONTROLTHINGS - SERIAL - Send UTF-8",
      "description": "ControlThings ctserial: Send UTF-8 text payload to serial device. Sends data to serial devices in authorized lab environments.",
      "tactic": "Impair Process Control",
      "tcode": "T0831",
      "executor": "bash",
      "executor_config": {
        "timeout_seconds": 30,
        "result_parser": "morgana-marker-v1"
      },
      "platform": "linux",
      "command": "# ControlThings Serial — Send UTF-8 text payload to serial device\nRUNNER='{{asset:controlthings_serial_runner}}'\n\ncase \"#{ct_serial_device}\" in ''|*[!A-Za-z0-9./_:-]*) echo \"[ERROR] Invalid device\" >&2; exit 2;; esac\n\npython3 \"$RUNNER\" ctserial connect \"#{ct_serial_device}\" #{ct_serial_baud} #{ct_serial_parity}\npython3 \"$RUNNER\" ctserial send_utf8 \"#{ct_serial_payload}\"\npython3 \"$RUNNER\" ctserial close\n\necho \"MORGANA_RESULT_METADATA={\\\"provider\\\":\\\"controlthings\\\",\\\"component\\\":\\\"ctserial\\\",\\\"operation\\\":\\\"send-utf8\\\",\\\"status\\\":\\\"completed\\\"}\"",
      "cleanup_command": null,
      "required_tags": [
        "ct_serial_device",
        "ct_serial_baud",
        "ct_serial_parity",
        "ct_serial_payload",
        "ct_serial_timeout"
      ],
      "required_assets": [
        "controlthings_serial_runner"
      ],
