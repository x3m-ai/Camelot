    "k8s":      {"requires_aws_auth": false, "requires_azure_auth": false, "requires_gcp_auth": false, "requires_kube_context": true},
    "eks":      {"requires_aws_auth": true,  "requires_azure_auth": false, "requires_gcp_auth": false, "requires_kube_context": true}
  }
