  "_default_mapping": {
    "discovery": "interact",
    "initial-access": "interact",
    "execution": "modify",
    "persistence": "modify",
    "privilege-escalation": "modify",
    "lateral-movement": "modify",
    "credential-access": "modify",
    "defense-evasion": "modify",
    "collection": "modify",
    "exfiltration": "disrupt",
    "impact": "disrupt"
