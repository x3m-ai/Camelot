      "command": "Write-Host '[START] T1594 - Search Victim-Owned Websites (HTTP fingerprinting + path enumeration)'; $targetDomain = '#{excalibur_recon_target_domain}'; $ua = 'MorganaTest-T1594-WebRecon/1.0'; Write-Host '[INFO] Phase 1/3: Internal web service discovery (localhost + gateway scan)'; $gw = (Get-NetRoute -DestinationPrefix '0.0.0.0/0' -ErrorAction SilentlyContinue | Sort-Object RouteMetric | Select-Object -First 1).NextHop; $scanTargets = @('127.0.0.1'); if ($gw) { $scanTargets += $gw }; $webPorts = @(80,443,8080,8443,8888,9090,5000,3000,8000,7001); foreach ($scanTarget in $scanTargets) { Write-Host ('[INFO] Scanning ' + $scanTarget + ' for web services...'); foreach ($port in $webPorts) { try { $proto = if ($port -in @(443,8443)) { 'https' } else { 'http' }; $url = $proto + '://' + $scanTarget + ':' + $port + '/'; $webReq = [System.Net.WebRequest]::Create($url); $webReq.Timeout = 2000; $webReq.Method = 'HEAD'; if ($proto -eq 'https') { $webReq.ServerCertificateValidationCallback = {$true} }; try { $webResp = $webReq.GetResponse(); $server = $webResp.Headers['Server']; $xpow = $webResp.Headers['X-Powered-By']; $xasp = $webResp.Headers['X-AspNet-Version']; Write-Host ('[INFO]   OPEN ' + $url + ' | Server: ' + $server + ' | X-Powered-By: ' + $xpow + ' | X-AspNet: ' + $xasp); $webResp.Close() } catch [System.Net.WebException] { if ($_.Exception.Response) { $sc = [int]$_.Exception.Response.StatusCode; if ($sc -gt 0) { $svr = $_.Exception.Response.Headers['Server']; Write-Host ('[INFO]   HTTP ' + $sc + ' at ' + $url + ' (Server: ' + $svr + ')') } } } } catch {} } }; Write-Host '[INFO] Phase 2/3: Target domain technology fingerprinting'; $targetUrl = 'https://' + $targetDomain + '/'; try { $fpReq = [System.Net.WebRequest]::Create($targetUrl); $fpReq.Timeout = 5000; $fpReq.Method = 'GET'; $fpReq.Headers.Add('User-Agent', $ua); $fpReq.ServerCertificateValidationCallback = {$true}; $fpResp = $fpReq.GetResponse(); $headers = @('Server','X-Powered-By','X-AspNet-V