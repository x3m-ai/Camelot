      "command": "Write-Host '[START] T1595.001 - Scanning IP Blocks (subnet sweep from foothold)'\n$target = '#{excalibur_recon_scan_target}'\n$baseIP = $target -replace '\\.\\d+$',''\n$ports = @(21,22,23,80,443,445,3389,5985,5986)\n$random = New-Object System.Random\n\n# Scan a /24 subnet around the target with randomized timing\nWrite-Host ('[INFO] Scanning /24 subnet around ' + $baseIP + '.0/24')\n1..254 | ForEach-Object {\n    $ip = $baseIP + '.' + $_\n    $delay = $random.Next(200, 1500)\n    Start-Sleep -Milliseconds $delay\n    \n    # ICMP ping first\n    try {\n        $ping = New-Object System.Net.NetworkInformation.Ping\n        $reply = $ping.Send($ip, 500)\n        if ($reply.Status -eq 'Success') {\n            Write-Host ('[INFO] Host ' + $ip + ' is alive (RTT: ' + $reply.RoundtripTime + 'ms)')\n            \n            # Scan a random subset of ports for each live host\n            $portsToScan = $ports | Sort-Object { $random.Next() } | Select-Object -First 3\n            foreach ($port in $portsToScan) {\n                try {\n                    $tcp = New-Object System.Net.Sockets.TcpClient\n                    $conn = $tcp.BeginConnect($ip, $port, $null, $null)\n                    $ok = $conn.AsyncWaitHandle.WaitOne(500)\n                    if ($ok -and $tcp.Connected) {\n                        Write-Host ('[INFO]   Port ' + $port + '/tcp OPEN on ' + $ip)\n                    }\n                    $tcp.Close()\n                } catch {}\n            }\n        }\n    } catch {}\n}\nWrite-Host '[SUCCESS] T1595.001 emulation completed'"
