      "command": "Write-Host '[START] T1590 - Gather Victim Network Information (DNS deep enumeration from foothold)'; $domain = '#{excalibur_recon_target_domain}'; Write-Host ('[INFO] Target domain: ' + $domain); $recordTypes = @('A','AAAA','MX','NS','TXT','SOA','CNAME'); foreach ($rtype in $recordTypes) { try { $recs = Resolve-DnsName -Name $domain -Type $rtype -ErrorAction SilentlyContinue -DnsOnly; if ($recs) { Write-Host ('[INFO] ' + $rtype + ' records (' + @($recs).Count + '):'); $recs | Select-Object -First 5 | ForEach-Object { $val = if ($_.IPAddress) { $_.IPAddress } elseif ($_.NameHost) { $_.NameHost } elseif ($_.NameExchange) { $_.NameExchange } elseif ($_.PrimaryServer) { $_.PrimaryServer } elseif ($_.Strings) { $_.Strings -join ' ' } else { $_.ToString() }; Write-Host ('    ' + $rtype + ': ' + [string]$val) } } else { Write-Host ('[INFO] ' + $rtype + ': no records found') } } catch { Write-Host ('[INFO] ' + $rtype + ': ' + $_.Exception.Message.Split([char]10)[0]) } }; Write-Host '[INFO] DNS zone transfer attempt (AXFR) - adversaries always try this'; try { $axfrResult = & nslookup.exe -type=axfr $domain 2>&1; $axfrSuccess = $axfrResult | Where-Object { $_ -match 'internet address|mail exchanger' }; Write-Host ('[INFO] AXFR result: ' + $(if (@($axfrSuccess).Count -gt 0) { 'ZONE TRANSFER SUCCEEDED (' + @($axfrSuccess).Count + ' records)' } else { 'REFUSED/FAILED (expected - zone transfer disabled)' })) } catch { Write-Host ('[INFO] AXFR: ' + $_.Exception.Message) }; Write-Host '[INFO] Subdomain brute-force (20 common subdomains)'; $subdomains = @('www','mail','ftp','vpn','remote','portal','intranet','dev','staging','api','admin','owa','autodiscover','smtp','mx','ns1','ns2','webmail','shop','app'); foreach ($sub in $subdomains) { $fqdn = $sub + '.' + $domain; try { $r = Resolve-DnsName -Name $fqdn -Type A -ErrorAction SilentlyContinue -DnsOnly; if ($r) { Write-Host ('[INFO]   FOUND: ' + $fqdn + ' -> ' + ($r | Where-Object { $_.IPAddress } | Select-Object -First 1 -ExpandProperty IPAddress)) } } catch {} }; Write-Host '[INFO] Reverse DNS lookup (PTR records on A record IPs)'; try { $aRecs = Resolve-DnsName -Name $domain -Type A -ErrorAction SilentlyContinue -DnsOnly | Where-Object { $_.IPAddress }; foreach ($aRec in @($aRecs)[0..2]) { try { $ptr = Resolve-DnsName -Name $aRec.IPAddress -Type PTR -ErrorAction SilentlyContinue; Write-Host ('[INFO]   PTR ' + $aRec.IPAddress + ' -> ' + $(if ($ptr) { $ptr[0].NameHost } else { 'no PTR' })) } catch {} } } catch {}; Write-Host '[SUCCESS] T1590 - DNS network info gathering completed. Sentinel target: High-volume multi-type DNS queries including AXFR attempt from non-DNS-tool process (MDE DNS telemetry - network recon behavioral detection)'",
      "cleanup_command": "Write-Host '[INFO] T1590 cleanup: no artefacts - DNS queries only'",
      "detection_rule": "High-volume multi-type DNS queries + AXFR zone transfer attempt from non-DNS-tool process",
      "sentinel_connector": "Microsoft Defender for Endpoint",
      "source": "excalibur",
      "package_id": "excalibur-reconnaissance-v1"
    },
