      "command": "Write-Host '[START] T1596.004 - CDN Reconnaissance (CDN detection and origin IP discovery)'\n$domain = '#{excalibur_recon_target_domain}'\n$ua = 'MorganaTest-T1596.004-CDNRecon/1.0'\n\n# CDN IP ranges for detection\n$cdnRanges = @{\n    'Cloudflare' = @('103.21.244.','103.22.200.','103.31.4.','104.16.','104.17.','104.18.','104.19.','104.20.','104.21.','104.22.','108.162.','131.0.72.','141.101.','162.158.','172.64.','172.65.','172.66.','172.67.','173.245.','188.114.','190.93.','197.234.','198.41.')\n    'Akamai' = @('23.32.','23.40.','23.48.','72.246.','96.16.','96.17.','96.6.')\n    'Fastly' = @('23.235.32.','43.249.72.','103.244.50.','103.245.222.','103.245.223.','104.156.80.','151.101.')\n    'Azure CDN' = @('13.107.','13.64.','13.65.','13.66.','13.77.','23.96.','40.112.','40.113.','40.114.','52.232.')\n    'Cloudfront' = @('13.224.','13.225.','13.226.','13.227.','13.228.','13.229.','13.230.','13.231.','13.32.','13.33.','13.35.')\n}\n\nWrite-Host '[INFO] Resolving target IPs...'\ntry {\n    $ips = [System.Net.Dns]::GetHostAddresses($domain) | Select-Object -ExpandProperty IPAddressToString\n    Write-Host ('[INFO] ' + $domain + ' resolves to: ' + ($ips -join ', '))\n    \n    foreach ($ip in $ips) {\n        $detectedCDN = $null\n        foreach ($cdn in $cdnRanges.Keys) {\n            foreach ($range in $cdnRanges[$cdn]) {\n                if ($ip.StartsWith($range)) {\n                    $detectedCDN = $cdn\n                    break\n                }\n            }\n            if ($detectedCDN) { break }\n        }\n        if ($detectedCDN) {\n            Write-Host ('[INFO] CDN DETECTED: ' + $ip + ' belongs to ' + $detectedCDN)\n        } else {\n            Write-Host ('[INFO] Possible origin IP (no CDN detected): ' + $ip)\n        }\n    }\n} catch {\n    Write-Host ('[INFO] DNS resolution: ' + $_.Exception.Message.Split([char]10)[0])\n}\n\nWrite-Host '[INFO] Checking CDN-specific HTTP headers...'\ntry {\n    $req = [System.Net.WebRequest]::Create('https://' + $domain + '/')\n    $req.Timeout = 5000\n    $req.Method = 'HEAD'\n    $req.ServerCertificateValidationCallback = {$true}\n    $req.Headers.Add('User-Agent', $ua)\n    $resp = $req.GetResponse()\n    $cdnHeaders = @('CF-RAY','X-Cache','X-Served-By','X-Cache-Hits','X-Timer','Via','X-Amz-Cf-Id','X-Azure-Ref','Fastly-Debug-Digest')\n    foreach ($h in $cdnHeaders) {\n        $val = $resp.Headers[$h]\n        if ($val) { Write-Host ('[INFO] CDN header ' + $h + ': ' + $val) }\n    }\n    $resp.Close()\n} catch {\n    Write-Host ('[INFO] HTTP headers check: ' + $_.Exception.Message.Split([char]10)[0])\n}\n\nWrite-Host '[INFO] Testing for CDN bypass via direct IP...'\ntry {\n    $dnsResult = Resolve-DnsName -Name $domain -Type A -ErrorAction SilentlyContinue\n    if ($dnsResult) {\n        $ttl = ($dnsResult | Select-Object -First 1).TTL\n        Write-Host ('[INFO] DNS TTL: ' + $ttl + 's - ' + $(if ($ttl -le 300) { 'LOW TTL suggests CDN' } else { 'Normal TTL' }))\n    }\n} catch {}\nWrite-Host '[SUCCESS] T1596.004 emulation completed'",
