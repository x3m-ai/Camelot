      "required_tags": [],
      "command": "Write-Host '[START] T1592 - WinPEAS-style Host Enumeration (comprehensive local recon)'; Write-Host ''; Write-Host '[INFO] === SYSTEM INFORMATION ==='; try { $os = Get-WmiObject -Class Win32_OperatingSystem; $cs = Get-WmiObject -Class Win32_ComputerSystem; Write-Host ('    OS: ' + $os.Caption + ' Build ' + $os.BuildNumber + ' | ' + $os.OSArchitecture); Write-Host ('    Hostname: ' + $env:COMPUTERNAME + ' | Domain: ' + $cs.Domain + ' | Workgroup: ' + $cs.Workgroup); Write-Host ('    Uptime: ' + [math]::Round(((Get-Date) - $os.ConvertToDateTime($os.LastBootUpTime)).TotalHours,1) + 'h'); $ps = [System.Security.Principal.WindowsPrincipal][System.Security.Principal.WindowsIdentity]::GetCurrent(); Write-Host ('    Running as: ' + $env:USERDOMAIN + '\\' + $env:USERNAME + ' | Admin: ' + $ps.IsInRole([System.Security.Principal.WindowsBuiltInRole]::Administrator)) } catch { Write-Host ('[WARN] System info: ' + $_.Exception.Message) }; Write-Host ''; Write-Host '[INFO] === HOTFIXES / PATCHES (last 10) ==='; try { Get-HotFix | Sort-Object InstalledOn -Descending -ErrorAction SilentlyContinue | Select-Object -First 10 | ForEach-Object { Write-Host ('    ' + $_.HotFixID + ' | ' + $_.Description + ' | ' + $_.InstalledOn) } } catch {}; Write-Host ''; Write-Host '[INFO] === INSTALLED SOFTWARE (registry uninstall keys) ==='; try { $swPaths = @('HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*','HKLM:\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*','HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*'); $sw = $swPaths | ForEach-Object { Get-ItemProperty $_ -ErrorAction SilentlyContinue } | Where-Object { $_.DisplayName } | Select-Object DisplayName,DisplayVersion,Publisher | Sort-Object DisplayName -Unique; Write-Host ('    Total installed: ' + @($sw).Count + ' applications'); $sw | Select-Object -First 15 | ForEach-Object { Write-Host ('    ' + $_.DisplayName + ' ' + $_.DisplayVersion) } } catch {}; Write-Host ''; Write-Host '[INFO] === SERVICES WITH BINARY PATHS (potential DLL hijack / unquoted paths) ==='; try { $svcs = Get-WmiObject -Class Win32_Service -ErrorAction SilentlyContinue | Where-Object { $_.PathName -and $_.StartMode -ne 'Disabled' }; $unquoted = $svcs | Where-Object { $_.PathName -notmatch '^\"' -and $_.PathName -match ' ' -and $_.PathName -notmatch '^[A-Za-z]:\\Windows' }; Write-Host ('    Total services: ' + @($svcs).Count + ' | Potential unquoted path (non-Windows): ' + @($unquoted).Count); $unquoted | Select-Object -First 5 | ForEach-Object { Write-Host ('[WARN]   UNQUOTED: ' + $_.Name + ' -> ' + $_.PathName) } } catch {}; Write-Host ''; Write-Host '[INFO] === SCHEDULED TASKS (non-Microsoft, enabled) ==='; try { $tasks = Get-ScheduledTask -ErrorAction SilentlyContinue | Where-Object { $_.State -ne 'Disabled' -and $_.TaskPath -notmatch 'Microsoft' }; Write-Host ('    Non-Microsoft enabled tasks: ' + @($tasks).Count); $tasks | Select-Object -First 10 | ForEach-Object { $action = if ($_.Actions) { $_.Actions[0].Execute + ' ' + $_.Actions[0].Arguments } else { 'N/A' }; Write-Host ('    [' + $_.State + '] ' + $_.TaskName + ' -> ' + $action.Trim().Substring(0,[math]::Min(80,$action.Trim().Length))) } } catch {}; Write-Host ''; Write-Host '[INFO] === STARTUP REGISTRY ENTRIES (Run/RunOnce) ==='; $runKeys = @('HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run','HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run','HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\RunOnce','HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\RunOnce'); foreach ($key in $runKeys) { try { $entries = Get-ItemProperty -Path $key -ErrorAction SilentlyContinue; if ($entries) { $entries.PSObject.Properties | Where-Object { $_.Name -notmatch '^PS' } | ForEach-Object { Write-Host ('    [RUN] ' + $key.Split('\\')[-1] + ' ' + $key.Split('\\')[0] + ': ' + $_.Name + ' = ' + [string]$_.Value) } } } catch {} }; Write-Host ''; Write-Host '[INFO] === LOCAL SHARES ==='; try { $shares = Get-WmiObject -Class Win32_Share -ErrorAction SilentlyContinue; Write-Host ('    Shares: ' + @($shares).Count); $shares | ForEach-Object { Write-Host ('    \\\\' + $env:COMPUTERNAME + '\\' + $_.Name + ' -> ' + $_.Path + ' [' + $_.Type + ']') } } catch {}; Write-Host ''; Write-Host '[INFO] === OPEN PORTS (netstat-style) ==='; try { $listening = Get-NetTCPConnection -State Listen -ErrorAction SilentlyContinue | Sort-Object LocalPort; Write-Host ('    Listening TCP ports: ' + @($listening).Count); $listening | Select-Object -First 15 | ForEach-Object { $procName = try { (Get-Process -Id $_.OwningProcess -ErrorAction SilentlyContinue).ProcessName } catch { 'unknown' }; Write-Host ('    ' + $_.LocalAddress + ':' + $_.LocalPort + ' [' + $procName + ']') } } catch {}; Write-Host ''; Write-Host '[INFO] === CREDENTIAL FILE RECON (clear-text cred search) ==='; $credPatterns = @( @{Path='C:\\inetpub';Filter='web.config';Label='IIS web.config (may contain DB passwords)'}, @{Path=$env:APPDATA;Filter='*.rdp';Label='RDP saved connection files'}, @{Path=$env:USERPROFILE;Filter='.env';Label='.env files (API keys/passwords)'}, @{Path='C:\\Program Files';Filter='*.config';Label='Program .config files'} ); foreach ($cp in $credPatterns) { try { if (Test-Path $cp.Path) { $found = Get-ChildItem -Path $cp.Path -Filter $cp.Filter -Recurse -ErrorAction SilentlyContinue -Force | Where-Object { -not $_.PSIsContainer }; if (@($found).Count -gt 0) { Write-Host ('[WARN]   FOUND ' + @($found).Count + ' files: [' + $cp.Label + '] -> ' + ($found | Select-Object -First 3 -ExpandProperty FullName) -join ', ') } } } catch {} }; $samCheck = 'C:\\Windows\\System32\\config\\SAM'; if (Test-Path $samCheck) { Write-Host ('[WARN]   SAM hive accessible: ' + $samCheck + ' (shadow copy dump target)') }; Write-Host ''; Write-Host '[SUCCESS] T1592 - WinPEAS-style host enumeration completed. Sentinel target: Bulk system registry/WMI/file enumeration + credential file search + unquoted path scan (MDE - comprehensive host recon behavioral detection)'",
