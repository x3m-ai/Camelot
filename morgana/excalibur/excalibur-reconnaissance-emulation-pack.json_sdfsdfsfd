n    $ssl = New-Object System.Net.Security.SslStream($tcp.GetStream(), $false, {$true})\n    $ssl.AuthenticateAsClient($domain)\n    $cert = $ssl.RemoteCertificate\n    if ($cert) {\n        $cert2 = New-Object System.Security.Cryptography.X509Certificates.X509Certificate2($cert)\n        Write-Host ('[INFO] Subject: ' + $cert2.Subject)\n        Write-Host ('[INFO] Issuer: ' + $cert2.Issuer)\n        Write-Host ('[INFO] Valid from: ' + $cert2.NotBefore)\n        Write-Host ('[INFO] Valid until: ' + $cert2.NotAfter)\n        Write-Host ('[INFO] Serial: ' + $cert2.SerialNumber)\n        Write-Host ('[INFO] Thumbprint: ' + $cert2.Thumbprint)\n        Write-Host ('[INFO] SANs: ' + ($cert2.Extensions | Where-Object { $_.Oid.Value -eq '2.5.29.17' } | ForEach-Object { $_.Format($true) }))\n    }\n    $ssl.Close()\n    $tcp.Close()\n} catch {\n    Write-Host ('[INFO] TLS extraction: ' + $_.Exception.Message.Split([char]10)[0])\n}\nWrite-Host '[SUCCESS] T1596.003 emulation completed'"
