      "command": "Write-Host '[START] T1595.003 - Wordlist Scanning (common paths/subdomains)'\n$domain = '#{excalibur_recon_target_domain}'\n$paths = @('/admin','/login','/api','/wp-admin','/console','/manager','/backup','/test','/dev','/staging')\n$subdomains = @('www','mail','ftp','vpn','remote','portal','intranet','dev','staging','api')\n$random = New-Object System.Random\n\n# Test common web paths\nWrite-Host '[INFO] Testing common web paths...'\nforeach ($path in $paths) {\n    $delay = $random.Next(500, 2000)\n    Start-Sleep -Milliseconds $delay\n    try {\n        $url = 'http://' + $domain + $path\n        $req = [System.Net.WebRequest]::Create($url)\n        $req.Timeout = 2000\n        $req.Method = 'HEAD'\n        $resp = $req.GetResponse()\n        Write-Host ('[INFO] Path found: ' + $url + ' (' + $resp.StatusCode + ')')\n        $resp.Close()\n    } catch [System.Net.WebException] {\n        if ($_.Exception.Response) {\n            $sc = [int]$_.Exception.Response.StatusCode\n            if ($sc -ne 404) {\n                Write-Host ('[INFO] Path response: ' + $url + ' (' + $sc + ')')\n            }\n        }\n    } catch {}\n}\n\n# Test common subdomains\nWrite-Host '[INFO] Testing common subdomains...'\nforeach ($sub in $subdomains) {\n    $delay = $random.Next(500, 2000)\n    Start-Sleep -Milliseconds $delay\n    try {\n        $fqdn = $sub + '.' + $domain\n        $ip = [System.Net.Dns]::GetHostAddresses($fqdn)[0].IPAddressToString\n        Write-Host ('[INFO] Subdomain found: ' + $fqdn + ' -> ' + $ip)\n    } catch {}\n}\nWrite-Host '[SUCCESS] T1595.003 emulation completed'"
