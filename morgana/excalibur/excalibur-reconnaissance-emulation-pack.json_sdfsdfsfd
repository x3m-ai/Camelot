      "command": "Write-Host '[START] T1595.002 - Vulnerability Scanning (service version detection)'\n$target = '#{excalibur_recon_scan_target}'\n$services = @(\n    @{Port=80;Path='/';Headers=@('Server','X-Powered-By')},\n    @{Port=443;Path='/';Headers=@('Server','X-Powered-By')},\n    @{Port=8080;Path='/';Headers=@('Server','X-Powered-By')},\n    @{Port=445;Type='SMB'},\n    @{Port=3389;Type='RDP'}\n)\n\nforeach ($svc in $services) {\n    if ($svc.Type) {\n        # Protocol-specific checks\n        if ($svc.Type -eq 'SMB') {\n            try {\n                $smb = New-Object System.Net.Sockets.TcpClient($target, 445)\n                $stream = $smb.GetStream()\n                $writer = New-Object System.IO.StreamWriter($stream)\n                $reader = New-Object System.IO.StreamReader($stream)\n                $writer.WriteLine('\\x00\\x00\\x00\\x85\\xff\\x53\\x4d\\x42\\x72\\x00\\x00\\x00\\x00\\x18\\x53\\xc8\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\xff\\xfe\\x00\\x00\\x00\\x00')\n                $writer.Flush()\n                $response = $reader.ReadToEnd()\n                Write-Host ('[INFO] SMB service detected on ' + $target + ':445')\n                if ($response -match 'SMB') {\n                    Write-Host ('    SMB version: ' + ($response -split '\\n' | Select-String 'SMB' | Select-Object -First 1))\n                }\n                $smb.Close()\n            } catch {}\n        }\n    } else {\n        # HTTP service checks\n        try {\n            $url = 'http://' + $target + ':' + $svc.Port + $svc.Path\n            $req = [System.Net.WebRequest]::Create($url)\n            $req.Timeout = 2000\n            $req.Method = 'GET'\n            $resp = $req.GetResponse()\n            $headers = ''\n            foreach ($h in $svc.Headers) {\n                $val = $resp.Headers[$h]\n                if ($val) { $headers += ' | ' + $h + ': ' + $val }\n            }\n            Write-Host ('[INFO] HTTP service on ' + $target + ':' + $svc.Port + $headers)\n            $resp.Close()\n        } catch {}\n    }\n}\nWrite-Host '[SUCCESS] T1595.002 emulation completed'"
      "cleanup_command": "Write-Host '[INFO] T1595.002 cleanup: no artefacts created - network connections only'",
      "detection_rule": "HTTP header extraction + service version probing from non-browser process (T1595.002 pattern)",
