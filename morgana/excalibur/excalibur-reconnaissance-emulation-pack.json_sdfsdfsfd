 -TimeoutSec 5 -UseBasicParsing -ErrorAction Stop\n    $bgpData = $bgpResp.Content | ConvertFrom-Json\n    if ($bgpData.data) {\n        Write-Host ('[INFO] ASN: AS' + $bgpData.data.asn + ' | ' + $bgpData.data.name + ' | ' + $bgpData.data.description_short)\n    }\n} catch {\n    Write-Host ('[INFO] BGP lookup: ' + $_.Exception.Message.Split([char]10)[0])\n}\nWrite-Host '[SUCCESS] T1596.002 emulation completed'"
