      "command": "Write-Host '[START] T1589 - Gather Victim Identity Information (user/group/LDAP enumeration)'; Write-Host '[INFO] Step 1/5: Local users (net user)'; try { $netUserOutput = & net.exe user 2>&1; $localUsers = $netUserOutput | Where-Object { $_ -match '^\\s+\\S' } | ForEach-Object { $_.Trim() -split '\\s{2,}' } | Where-Object { $_ -ne '' -and $_ -notmatch '^-' }; Write-Host ('[INFO] Local users: ' + @($localUsers).Count + ' -> ' + ($localUsers -join ', ')) } catch { Write-Host ('[INFO] net user: ' + $_.Exception.Message) }; Write-Host '[INFO] Step 2/5: Local privileged group membership'; $privGroups = @('Administrators','Remote Desktop Users','Remote Management Users','Backup Operators','Power Users','Network Configuration Operators'); foreach ($grp in $privGroups) { try { $members = & net.exe localgroup $grp 2>&1 | Where-Object { $_ -match '^\\S' -and $_ -notmatch 'Alias|Comment|Members|command|----' }; if (@($members).Count -gt 0) { Write-Host ('[INFO]   ' + $grp + ': ' + ($members | Where-Object {$_} | ForEach-Object {$_.Trim()}) -join ', ') } else { Write-Host ('[INFO]   ' + $grp + ': empty or access denied') } } catch {} }; Write-Host '[INFO] Step 3/5: Service accounts (services NOT running as SYSTEM/LocalService/NetworkService)'; try { $svcAccounts = Get-WmiObject -Class Win32_Service -ErrorAction SilentlyContinue | Where-Object { $_.StartName -and $_.StartName -notmatch 'LocalSystem|LocalService|NetworkService|NT AUTHORITY' -and $_.State -eq 'Running' }; Write-Host ('[INFO] Non-default service accounts running: ' + @($svcAccounts).Count); $svcAccounts | Select-Object -First 10 | ForEach-Object { Write-Host ('    ' + $_.Name + ' runs as: ' + $_.StartName) } } catch {}; Write-Host '[INFO] Step 4/5: Active Directory user enumeration (LDAP - domain-joined only)'; try { $domain = [System.DirectoryServices.ActiveDirectory.Domain]::GetCurrentDomain(); $dcName = $domain.FindDomainController().Name; Write-Host ('[INFO] Domain: ' + $domain.Name + ' | DC: ' + $dcName); $searcher = New-Object System.DirectoryServices.DirectorySearcher; $searcher.Filter = '(&(objectCategory=person)(objectClass=user)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))'; $searcher.PropertiesToLoad.AddRange(@('sAMAccountName','displayName','memberOf','adminCount')) | Out-Null; $searcher.SizeLimit = 50; $results = $searcher.FindAll(); Write-Host ('[INFO] Active users in AD (max 50): ' + $results.Count); $results | Select-Object -First 10 | ForEach-Object { $sam = $_.Properties['sAMAccountName']; $admin = $_.Properties['adminCount']; Write-Host ('    ' + $sam + $(if ($admin -and $admin[0] -eq 1) { ' [ADMIN-COUNT=1 - privileged account]' } else { '' })) }; $results.Dispose() } catch { Write-Host ('[INFO] LDAP user enum: ' + $_.Exception.Message.Split([char]10)[0] + ' (workgroup machine or access denied)') }; Write-Host '[INFO] Step 5/5: Domain admin group LDAP query'; try { $daSearcher = New-Object System.DirectoryServices.DirectorySearcher; $daSearcher.Filter = '(&(objectCategory=group)(cn=Domain Admins))'; $daSearcher.PropertiesToLoad.Add('member') | Out-Null; $daResult = $daSearcher.FindOne(); if ($daResult) { $members = $daResult.Properties['member']; Write-Host ('[INFO] Domain Admins members: ' + @($members).Count); $members | Select-Object -First 10 | ForEach-Object { Write-Host ('    ' + ($_ -split ',')[0] -replace 'CN=','') } } } catch { Write-Host ('[INFO] Domain Admins LDAP: ' + $_.Exception.Message.Split([char]10)[0]) }; Write-Host '[SUCCESS] T1589 - Identity information gathering completed. Sentinel target: net.exe user/localgroup + LDAP DirectorySearcher user enumeration (MDE - identity recon behavioral detection)'",
      "cleanup_command": "Write-Host '[INFO] T1589 cleanup: no artefacts - read-only user/group enumeration'",
