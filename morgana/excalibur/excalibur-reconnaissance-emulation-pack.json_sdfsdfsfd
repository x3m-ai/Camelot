      "command": "Write-Host '[START] T1595 - Active Scanning (TCP port scan from foothold - nmap-style)'; $target = '#{excalibur_recon_scan_target}'; $scanPorts = @( @{Port=21;Service='FTP'}, @{Port=22;Service='SSH'}, @{Port=23;Service='Telnet'}, @{Port=25;Service='SMTP'}, @{Port=80;Service='HTTP'}, @{Port=135;Service='MS-RPC'}, @{Port=139;Service='NetBIOS'}, @{Port=389;Service='LDAP'}, @{Port=443;Service='HTTPS'}, @{Port=445;Service='SMB'}, @{Port=636;Service='LDAPS'}, @{Port=1433;Service='MSSQL'}, @{Port=3306;Service='MySQL'}, @{Port=3389;Service='RDP'}, @{Port=5432;Service='PostgreSQL'}, @{Port=5985;Service='WinRM-HTTP'}, @{Port=5986;Service='WinRM-HTTPS'}, @{Port=6379;Service='Redis'}, @{Port=8080;Service='HTTP-Alt'}, @{Port=9200;Service='Elasticsearch'} ); Write-Host ('[INFO] Scanning target: ' + $target + ' | Ports: ' + $scanPorts.Count + ' | Timeout: 1000ms per port'); $open = @(); $closed = @(); $startTime = Get-Date; foreach ($entry in $scanPorts) { try { $tcp = New-Object System.Net.Sockets.TcpClient; $conn = $tcp.BeginConnect($target, $entry.Port, $null, $null); $ok = $conn.AsyncWaitHandle.WaitOne(1000); if ($ok -and $tcp.Connected) { $open += $entry; Write-Host ('[INFO]   ' + $entry.Port + '/tcp OPEN [' + $entry.Service + ']') } else { $closed += $entry }; $tcp.Close() } catch { $closed += $entry } }; $elapsed = [math]::Round(((Get-Date) - $startTime).TotalSeconds, 1); Write-Host ('[INFO] Scan complete in ' + $elapsed + 's | Open: ' + $open.Count + ' | Closed/Filtered: ' + $closed.Count); Write-Host ('[INFO] Open ports summary: ' + $(if ($open.Count -gt 0) { ($open | ForEach-Object { [string]$_.Port + '/' + $_.Service }) -join ', ' } else { 'none (all filtered or unreachable)' })); Write-Host '[INFO] ICMP reachability check (ping sweep pattern)'; try { $ping = [System.Net.NetworkInformation.Ping]::new(); $reply = $ping.Send($target, 1000); Write-Host ('[INFO] ICMP to ' + $target + ': ' + $reply.Status + $(if ($reply.Status -eq 'Success') { ' RTT=' + $reply.RoundtripTime + 'ms' } else { '' })); $ping.Dispose() } catch { Write-Host ('[INFO] ICMP: ' + $_.Exception.Message) }; Write-Host '[INFO] UDP DNS probe (service version detection on port 53)'; try { $udp = New-Object System.Net.Sockets.UdpClient; $udp.Client.ReceiveTimeout = 1000; $dnsQuery = [byte[]](0x00,0x01,0x01,0x00,0x00,0x01,0x00,0x00,0x00,0x00,0x00,0x00,0x07,0x76,0x65,0x72,0x73,0x69,0x6F,0x6E,0x04,0x62,0x69,0x6E,0x64,0x00,0x00,0x10,0x00,0x03); $udp.Send($dnsQuery, $dnsQuery.Length, $target, 53) | Out-Null; $ep = New-Object System.Net.IPEndPoint([System.Net.IPAddress]::Any, 0); try { $resp = $udp.Receive([ref]$ep); Write-Host ('[INFO] UDP/53 DNS response from ' + $target + ': ' + $resp.Length + ' bytes (DNS service detected)') } catch { Write-Host ('[INFO] UDP/53: no response (timeout)') }; $udp.Close() } catch { Write-Host ('[INFO] UDP DNS: ' + $_.Exception.Message) }; Write-Host '[SUCCESS] T1595 - Active scanning simulation completed. Sentinel target: Rapid sequential TCP connections to multiple service ports from non-network-tool process (MDE - active scanning from foothold behavioral detection)'",
