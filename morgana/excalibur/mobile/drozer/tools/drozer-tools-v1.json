      "id": "drozer:core:tools_setup_minimalsu",
      "name": "DROZER - tools.setup.minimalsu",
      "description": "Prepares 'minimal-su' binary installation files on the device in order to provide access to a root shell on demand.  This binary provides drozer the ability to maintain access to a root shell on the device after obtaining a temporary root shell via the use of an exploit. Just type `su` from a shell to get a root shell.  WARNING: This minimal version of the su binary is completely unprotected, meaning that any application on the device can obtain a root shell without any user prompting.",
      "tactic": "Mobile Application Security Assessment",
      "tcode": "T0000",
      "executor": "python",
