    {
      "id": "drozer:core:tools_setup_toybox",
      "name": "DROZER - tools.setup.toybox",
      "description": "Installs Toybox on the Agent.  Toybox provides a number of *nix utilities that are missing from Android. Some modules require Toybox to be installed.  Typically, you require root access to the device to install Toybox. drozer can install it from its restrictive context. You can then use 'toybox' in the when executing shell commands from drozer to use it.",
      "tactic": "Mobile Application Security Assessment",
      "tcode": "T0000",
      "executor": "python",
      "executor_config": {
        "timeout_seconds": 180,
        "result_parser": "morgana-marker-v1"
