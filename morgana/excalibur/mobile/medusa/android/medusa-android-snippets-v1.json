      "id": "medusa:android:snippet:dynamicpatch",
      "name": "MEDUSA - ANDROID - snippet - Dynamicpatch",
      "description": "MEDUSA standalone Frida snippet: Dynamicpatch",
      "tactic": "Mobile Runtime Instrumentation",
      "tcode": "T0000",
      "executor": "frida",
