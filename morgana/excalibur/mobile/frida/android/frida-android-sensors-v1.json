      "id": "codeshare:dzervas/android-location-spoofing",
      "name": "FRIDA - ANDROID - Location - Android Location Spoofing [4299a7cc]",
      "description": "Spoofs the current location reported by GPS",
      "tactic": "Mobile Runtime Instrumentation",
      "tcode": "T1430",
      "executor": "frida",
      "executor_config": {
        "target_platform": "android",
        "target": "#{mobile_app_id}",
        "device": "#{mobile_device_id}",
        "transport": "usb",
        "mode": "spawn",
        "resume": true,
        "max_stdout_bytes": 102400,
        "max_stderr_bytes": 102400
      },
      "platform": "all",
