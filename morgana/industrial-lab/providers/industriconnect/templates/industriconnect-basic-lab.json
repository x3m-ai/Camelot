{
  "id": "industriconnect-basic-lab",
  "name": "IndustriConnect - Basic Industrial Lab",
  "description": "A small multi-protocol lab: one Modbus PLC and one OPC UA plant on the same host, for cross-protocol detection validation.",
  "providers": [
    "industriconnect"
  ],
  "services": [
    {
      "service_id": "industriconnect-modbus",
      "preset": "default-device",
      "port": 1502,
      "friendly_name": "MODBUS-PLC-01"
    },
    {
      "service_id": "industriconnect-opcua",
      "preset": "default-plant",
      "port": 4840,
      "friendly_name": "PUMP-STATION-OPCUA"
    }
  ],
  "host_placement": {
    "all_services_on_one_host": true
  },
  "startup_order": [
    "industriconnect-modbus",
    "industriconnect-opcua"
  ],
  "shutdown_order": [
    "industriconnect-opcua",
    "industriconnect-modbus"
  ],
  "reset_policy": "reset-all-services"
}
