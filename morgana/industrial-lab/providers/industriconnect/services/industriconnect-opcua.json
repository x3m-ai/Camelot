{
  "schema_version": "1.0",
  "service_id": "industriconnect-opcua",
  "provider": "industriconnect",
  "name": "OPC UA Industrial Plant Server",
  "description": "Rich mock OPC UA server simulating an industrial plant with sensor variables, actuator controls, system status and management methods (StartProduction, StopProduction, EmergencyStop).",
  "protocol": "opcua",
  "fidelity": "simulated industrial process / mock plant server.",
  "source_repository": "https://github.com/IndustriAgents/IndustriConnect",
  "source_commit": "aa634a12ece8186b3e6c775cea1917ea89418f5e",
  "source_path": "OPCUA-Project/opcua-local-server",
  "project_dir": "OPCUA-Project",
  "subdir": "opcua-local-server",
  "license": "MIT",
  "license_status": "declared-mit-in-pyproject",
  "runtime_type": "python-process",
  "supported_platforms": [
    "linux",
    "windows",
    "macos"
  ],
  "raw_network_required": false,
  "container_required": false,
  "requirements": [
    {
      "id": "python",
      "name": "Python 3.10+",
      "auto_install": false,
      "check_command": "python --version",
      "description": "Required to run the mock device."
    },
    {
      "id": "uv",
      "name": "uv package manager",
      "auto_install": false,
      "check_command": "uv --version",
      "description": "Required to install pinned dependencies and run the mock device."
    }
  ],
  "default_ports": [
    4840
  ],
  "config_schema": {
    "fields": [
      {
        "key": "host",
        "label": "Listen Interface",
        "type": "string",
        "default": "127.0.0.1",
        "required": true,
        "description": "Bind address: localhost only, Lab Host network, or custom."
      },
      {
        "key": "port",
        "label": "Port",
        "type": "int",
        "required": true,
        "description": "TCP port for the mock device."
      },
      {
        "key": "update_interval",
        "label": "Update Interval (s)",
        "type": "float",
        "default": "1.0",
        "required": false,
        "description": "How often the mock mutates simulated process values."
      }
    ],
    "env_port_var": "OPCUA_PORT",
    "env_host_var": "OPCUA_HOST"
  },
  "install": {
    "strategy": "uv-sync",
    "commands": [
      "uv",
      "sync"
    ]
  },
  "start": {
    "commands": [
      "uv",
      "run",
      "python",
      "opcua_local_server.py"
    ]
  },
  "stop": {
    "strategy": "terminate-process"
  },
  "restart": {
    "strategy": "stop-then-start"
  },
  "reset": {
    "strategy": "restart-with-seed"
  },
  "health": {
    "strategy": "tcp-connect",
    "port_ref": "$config.port"
  },
  "logs": {
    "source": "process-stdout-stderr"
  },
  "state_inspection": {
    "supports_state_inspection": true
  },
  "multiple_instance_support": true,
  "compatible_scripts": {
    "protocol": "opcua",
    "package": "industriconnect-opcua-v1"
  },
  "presets": [
    {
      "id": "default-plant",
      "name": "Default Plant",
      "description": "Upstream default plant with sensors and actuators."
    }
  ]
}
