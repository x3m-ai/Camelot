{
  "schema_version": "1.0",
  "service_id": "industriconnect-dnp3",
  "provider": "industriconnect",
  "name": "DNP3 Mock Outstation",
  "description": "Mock DNP3 outstation exposing a JSON-over-TCP bridge simulating binary/analog input points and outputs.",
  "protocol": "dnp3",
  "fidelity": "mock outstation / test endpoint.",
  "source_repository": "https://github.com/IndustriAgents/IndustriConnect",
  "source_commit": "aa634a12ece8186b3e6c775cea1917ea89418f5e",
  "source_path": "DNP3-Project/dnp3-mock-outstation",
  "project_dir": "DNP3-Project",
  "subdir": "dnp3-mock-outstation",
  "license": "MIT",
  "license_status": "declared-mit-in-pyproject",
  "runtime_type": "python-process",
  "supported_platforms": [
    "linux",
    "windows",
    "macos"
  ],
  "raw_network_required": false,
  "container_required": false,
  "requirements": [
    {
      "id": "python",
      "name": "Python 3.10+",
      "auto_install": false,
      "check_command": "python --version",
      "description": "Required to run the mock device."
    },
    {
      "id": "uv",
      "name": "uv package manager",
      "auto_install": false,
      "check_command": "uv --version",
      "description": "Required to install pinned dependencies and run the mock device."
    }
  ],
  "default_ports": [
    7300
  ],
  "config_schema": {
    "fields": [
      {
        "key": "host",
        "label": "Listen Interface",
        "type": "string",
        "default": "127.0.0.1",
        "required": true,
        "description": "Bind address: localhost only, Lab Host network, or custom."
      },
      {
        "key": "port",
        "label": "Port",
        "type": "int",
        "required": true,
        "description": "TCP port for the mock device."
      },
      {
        "key": "update_interval",
        "label": "Update Interval (s)",
        "type": "float",
        "default": "1.0",
        "required": false,
        "description": "How often the mock mutates simulated process values."
      }
    ],
    "env_port_var": "MOCK_DNP3_PORT",
    "env_host_var": "MOCK_DNP3_HOST"
  },
  "install": {
    "strategy": "uv-sync",
    "commands": [
      "uv",
      "sync"
    ]
  },
  "start": {
    "commands": [
      "uv",
      "run",
      "dnp3-mock-outstation"
    ]
  },
  "stop": {
    "strategy": "terminate-process"
  },
  "restart": {
    "strategy": "stop-then-start"
  },
  "reset": {
    "strategy": "restart-with-seed"
  },
  "health": {
    "strategy": "tcp-connect",
    "port_ref": "$config.port"
  },
  "logs": {
    "source": "process-stdout-stderr"
  },
  "state_inspection": {
    "supports_state_inspection": true
  },
  "multiple_instance_support": true,
  "compatible_scripts": {
    "protocol": "dnp3",
    "package": "industriconnect-dnp3-v1"
  },
  "presets": [
    {
      "id": "default-outstation",
      "name": "Default Outstation",
      "description": "Upstream default point map."
    }
  ]
}
