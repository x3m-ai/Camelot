{
  "catalog_version": "1.0.0",
  "updated": "2026-08-31",
  "source": "https://github.com/x3m-ai/Camelot",
  "description": "Industrial Lab catalog — provider-agnostic lab service manifests and Lab templates. Camelot is the content/distribution plane; Morgana Server orchestrates and Morgana Agents act as Lab Hosts.",
  "providers": [
    {
      "id": "industriconnect",
      "name": "IndustriConnect",
      "description": "IndustriAgents IndustriConnect MCP suite: Python MCP servers + mock devices for BACnet, DNP3, EtherCAT, EtherNet/IP, Modbus, MQTT/Sparkplug B, OPC UA, PROFIBUS, PROFINET, and Siemens S7.",
      "source_repository": "https://github.com/IndustriAgents/IndustriConnect",
      "source_commit": "aa634a12ece8186b3e6c775cea1917ea89418f5e",
      "license": "MIT"
    }
  ],
  "services": [
    {
      "schema_version": "1.0",
      "service_id": "industriconnect-modbus",
      "provider": "industriconnect",
      "name": "Modbus Mock Device",
      "description": "Mock Modbus TCP device with a realistic register map (coils, discrete inputs, input registers, holding registers) that periodically mutates to mimic live plant data.",
      "protocol": "modbus",
      "fidelity": "simulated industrial process / mock device (not a hardware emulator).",
      "source_repository": "https://github.com/IndustriAgents/IndustriConnect",
      "source_commit": "aa634a12ece8186b3e6c775cea1917ea89418f5e",
      "source_path": "MODBUS-Project/modbus-mock-server",
      "project_dir": "MODBUS-Project",
      "subdir": "modbus-mock-server",
      "license": "MIT",
      "license_status": "declared-mit-in-pyproject",
      "runtime_type": "python-process",
      "supported_platforms": [
        "linux",
        "windows",
        "macos"
      ],
      "raw_network_required": false,
      "container_required": false,
      "requirements": [
        {
          "id": "python",
          "name": "Python 3.10+",
          "auto_install": false,
          "check_command": "python --version",
          "description": "Required to run the mock device."
        },
        {
          "id": "uv",
          "name": "uv package manager",
          "auto_install": false,
          "check_command": "uv --version",
          "description": "Required to install pinned dependencies and run the mock device."
        }
      ],
      "default_ports": [
        1502
      ],
      "config_schema": {
        "fields": [
          {
            "key": "host",
            "label": "Listen Interface",
            "type": "string",
            "default": "127.0.0.1",
            "required": true,
            "description": "Bind address: localhost only, Lab Host network, or custom."
          },
          {
            "key": "port",
            "label": "Port",
            "type": "int",
            "required": true,
            "description": "TCP port for the mock device."
          },
          {
            "key": "update_interval",
            "label": "Update Interval (s)",
            "type": "float",
            "default": "1.0",
            "required": false,
            "description": "How often the mock mutates simulated process values."
          }
        ],
        "env_port_var": "MODBUS_PORT",
        "env_host_var": "MODBUS_HOST"
      },
      "install": {
        "strategy": "uv-sync",
        "commands": [
          "uv",
          "sync"
        ]
      },
      "start": {
        "commands": [
          "uv",
          "run",
          "modbus-mock-server"
        ]
      },
      "stop": {
        "strategy": "terminate-process"
      },
      "restart": {
        "strategy": "stop-then-start"
      },
      "reset": {
        "strategy": "restart-with-seed"
      },
      "health": {
        "strategy": "tcp-connect",
        "port_ref": "$config.port"
      },
      "logs": {
        "source": "process-stdout-stderr"
      },
      "state_inspection": {
        "supports_state_inspection": true
      },
      "multiple_instance_support": true,
      "compatible_scripts": {
        "protocol": "modbus",
        "package": "industriconnect-modbus-v1"
      },
      "presets": [
        {
          "id": "default-device",
          "name": "Default Device",
          "description": "Upstream default register map."
        }
      ]
    },
